+import 'package:flutter/material.dart';
+
+class HyramWarrantyLabel extends StatelessWidget {
+  const HyramWarrantyLabel({
+    super.key,
+    required this.isUsed,
+    this.productId,
+  });
+
+  final bool isUsed;
+  final String? productId;
+
+  @override
+  Widget build(BuildContext context) {
+    final warranty = isUsed ? '중고 6개월' : '신제품 1년';
+    return Semantics(
+      label: 'HYRAM GOLF A/S 라벨 $warranty',
+      child: Container(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
+        decoration: BoxDecoration(
+          color: const Color(0xFFF3F3F1),
+          borderRadius: BorderRadius.circular(10),
+          border: Border.all(color: const Color(0xFFB8B8B2)),
+        ),
+        child: Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            const Icon(Icons.verified_outlined, size: 20),
+            const SizedBox(width: 8),
+            Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                const Text('HYRAM GOLF · A/S CARE',
+                    style: TextStyle(fontWeight: FontWeight.w800)),
+                Text('HYRAM WARRANTY · $warranty'),
+                Text(productId == null
+                    ? '제품 등록 시 관리번호 · QR 활성화'
+                    : '관리번호 $productId'),
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
